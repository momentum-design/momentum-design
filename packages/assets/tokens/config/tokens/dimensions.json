{
  "files": [
    {
      "destination": "spacing/complete",
      "cssSelector": ".mds-spacing",
      "targets": ["core/spacing.json"]
    },
    {
      "destination": "border/complete",
      "cssSelector": ".mds-border",
      "targets": ["core/border.json"]
    },
    {
      "destination": "radius/complete",
      "cssSelector": ".mds-radius",
      "targets": ["core/radius.json"]
    },
    {
      "destination": "size/complete",
      "cssSelector": ".mds-size",
      "targets": ["core/size.json"]
    },
    {
      "destination": "theme/momentum/spacing",
      "cssSelector": ".mds-theme-momentum",
      "targets": ["core/spacing.json", "theme/momentum/spacing.json"]
    },
    {
      "destination": "theme/momentum/border",
      "cssSelector": ".mds-theme-momentum",
      "targets": ["core/border.json", "theme/momentum/border.json"]
    },
    {
      "destination": "theme/momentum/radius",
      "cssSelector": ".mds-theme-momentum",
      "targets": ["core/radius.json", "theme/momentum/radius.json"]
    },
    {
      "destination": "theme/momentum/size",
      "cssSelector": ".mds-theme-momentum",
      "targets": ["core/size.json", "theme/momentum/size.json"]
    },
    {
      "destination": "theme/fluid/spacing",
      "cssSelector": ".mds-theme-fluid",
