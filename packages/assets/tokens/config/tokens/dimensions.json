{
  "files": [
    {
      "destination": "dimension/complete",
      "cssSelector": ".mds-dimension",
      "targets": [
        "core/dimension.json"
      ]
    },
    {
      "destination": "theme/stable/spacing",
      "cssSelector": ".mds-theme-stable",
      "targets": [
        "core/dimension.json",
        "theme/stable/spacing.json"
      ]
    },
    {
      "destination": "theme/stable/border",
      "cssSelector": ".mds-theme-stable",
      "targets": [
        "core/dimension.json",
        "theme/stable/border.json"
      ]
    },
    {
      "destination": "theme/stable/radius",
      "cssSelector": ".mds-theme-stable",
      "targets": [
        "core/dimension.json",
        "theme/stable/radius.json"
      ]
    },
    {
      "destination": "theme/stable/size",
      "cssSelector": ".mds-theme-stable",
      "targets": [
        "core/dimension.json",
        "theme/stable/size.json"
      ]
    },
    {
      "destination": "theme/fluid/spacing",
      "cssSelector": ".mds-theme-fluid",
      "targets": [
        "core/dimension.json",
        "theme/stable/spacing.json",
        "theme/fluid/spacing.json"
      ]
    },
    {
      "destination": "theme/fluid/border",
      "cssSelector": ".mds-theme-fluid",
      "targets": [
        "core/dimension.json",
        "theme/stable/border.json",
        "theme/fluid/border.json"
      ]
    },
    {
      "destination": "theme/fluid/radius",
      "cssSelector": ".mds-theme-fluid",
      "targets": [
        "core/dimension.json",
        "theme/stable/radius.json",
        "theme/fluid/radius.json"
      ]
    },
    {
      "destination": "theme/fluid/size",
      "cssSelector": ".mds-theme-fluid",
      "targets": [
        "core/dimension.json",
        "theme/stable/size.json",
        "theme/fluid/size.json"
      ]
    }
  ],
  "formats": [
    "CSS_VARIABLES",
    "SCSS_VARIABLES",
    "WEB_JSON",
    "ANDROID_RESOURCES",
    "SWIFT_CLASS",
    "MD_JSON_MINIMAL"
  ],
  "prefix": "mds",
  "outputReferences": true
}
