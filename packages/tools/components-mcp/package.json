{
  "name": "@momentum-design/components-mcp",
  "packageManager": "yarn@3.2.4",
  "version": "0.0.0",
  "description": "Model Context Protocol server for Momentum Design components",
  "type": "commonjs",
  "main": "./dist/module/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "./dist",
    "./USAGE.md"
  ],
  "bin": {
    "components-mcp": "./dist/module/index.js",
    "momentum-components-mcp": "./dist/module/index.js"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "analyze": "yarn analyze:prebuild && yarn analyze:postbuild",
    "analyze:lint": "eslint \"./src/**\"",
    "analyze:postbuild": "echo \"script 'analyze:postbuild' has not been implemented\"",
    "analyze:prebuild": "yarn generate:registry && yarn analyze:lint && yarn analyze:syntax",
    "analyze:syntax": "tsc --noEmit",
    "build": "yarn generate:registry && yarn build:module && yarn build:bin",
    "build:bin": "node ./scripts/make-bin-executable.js",
    "build:module": "tsc",
    "clean": "yarn clean:dist",
    "clean:dist": "rimraf ./dist",
    "docs": "echo \"script 'docs' has not been implemented\"",
    "generate:assets": "node ./scripts/generate-asset-registry.js",
    "generate:colors": "node ./scripts/generate-color-registry.js",
    "generate:components": "node ./scripts/generate-component-registry.js",
    "generate:registry": "yarn generate:components && yarn generate:assets && yarn generate:colors",
    "prepublishOnly": "yarn clean && yarn build",
    "publish": "yarn publish:npmjs",
    "publish:npmjs": "yarn npm publish --access=public",
    "start": "node ./dist/module/index.js",
    "test": "yarn test:prebuild && yarn test:postbuild",
    "test:postbuild": "echo \"script 'test:postbuild' has not been implemented\"",
    "test:prebuild": "yarn generate:registry && yarn test:unit",
    "test:unit": "jest ./src/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.58"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "20.14.9",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "8.27.0",
    "eslint-plugin-import": "^2.26.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.4",
    "typescript": "^5.9.2"
  }
}
