{{#each componentDependencies}}
import '../{{this}}';
{{/each}}
import {{componentClassName}} from './{{componentName}}.component';
import { TAG_NAME } from './{{componentName}}.constants';

{{componentClassName}}.register(TAG_NAME);

declare global {
    interface HTMLElementTagNameMap {
        ['{{prefix}}{{separator}}{{componentName}}']: {{componentClassName}}
    }
}

export default {{componentClassName}};
