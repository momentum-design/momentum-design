// Type-checks Code Connect template files only. They are excluded from the dist build
// (see src/tsconfig.json) and need the ambient 'figma' module declaration, so this
// deliberately does not extend the shared base config.
{
  "compilerOptions": {
    "noEmit": true,
    "target": "es2020",
    "module": "es2020",
    "lib": ["es2020"],
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["@figma/code-connect/figma-types"]
  },
  "include": ["src/components/**/*.figma.ts"]
}
