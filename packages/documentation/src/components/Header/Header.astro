---
import * as CONFIG from '../../config';
import manifest from '../../generated/knowledge-base/manifest.json';
import { getLanguageFromURL } from '../../languages';

import MomentumLogo from './MomentumLogo.astro';
import SkipToContent from './SkipToContent.astro';
import Search from './Search';
import GitHubTool from './GitHubTool';

const currentPage = Astro.url.pathname;

const currentPageMatch = currentPage.endsWith('/') ? currentPage.slice(1, -1) : currentPage.slice(1);
const langCode = getLanguageFromURL(currentPage);

const staticMenu = CONFIG.MAIN_MENU[langCode];
const staticMenuEntries = Object.entries(staticMenu).map(([name, item]) => ({
  name,
  index: item.index,
  slug: item.index.split('/').pop() ?? '',
}));
const staticSlugs = new Set(staticMenuEntries.map((entry) => entry.slug));
const generatedMenuEntries = manifest.sections
  .filter((section) => !staticSlugs.has(section.slug))
  .map((section) => ({
    name: section.title,
    index: manifest.routes[section.index].path,
    slug: section.slug,
  }));

const orderIndex = (slug: string) => {
  const position = CONFIG.HEADER_MENU_ORDER.indexOf(slug);
  return position === -1 ? CONFIG.HEADER_MENU_ORDER.length : position;
};
const menuEntries = [...staticMenuEntries, ...generatedMenuEntries].sort(
  (left, right) => orderIndex(left.slug) - orderIndex(right.slug),
);

function isCurrentPage(itemIndex: string) {
  if (itemIndex === 'en') {
    return currentPageMatch === itemIndex;
  }

  return currentPageMatch === itemIndex || currentPageMatch.startsWith(`${itemIndex}/`);
}
---

<header>
  <SkipToContent />
  <nav class="nav-wrapper" title="Top Navigation">
    <div class="logo flex">
      <a href={`${Astro.site?.pathname  }en`} aria-label="Home">
        <MomentumLogo height={40} />
      </a>
    </div>
    <div class="main-menu" style={{ alignItems: 'center' }}>
      {
        menuEntries.map((item) => {
          const url = Astro.site?.pathname + item.index;
          return (
            <li class="nav-link">
              <a href={url} aria-current={isCurrentPage(item.index) ? 'page' : false}>
                {item.name}
              </a>
            </li>
          );
        })
      }
      <GitHubTool client:load />
    </div>
    <div class="search-item">
      <Search client:idle />
    </div>
  </nav>
</header>

<style>
  header {
    z-index: 11;
    height: var(--theme-navbar-height);
    width: 100%;
    background-color: var(--theme-navbar-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: sticky;
    top: 0;
  }

  .logo {
    flex: 1;
    display: flex;
    overflow: hidden;
    width: 30px;
    font-size: 2rem;
    flex-shrink: 0;
    font-weight: 600;
    line-height: 1;
    color: hsla(var(--color-base-white), 100%, 1);
    gap: 0.25em;
  }

  .logo a {
    display: flex;
    text-decoration: none;
    font-weight: bold;
  }

  .logo a:hover {
    filter: brightness(1.2);
  }

  .logo a:focus {
    outline: none;
  }

  .logo h1 {
    display: none;
    font: inherit;
    color: inherit;
    margin: 0;
  }

  .main-menu {
    display: flex;
    gap: 1.25rem;
    margin-right: 1rem;
  }

  .main-menu > li {
    list-style: none;
  }

  .nav-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    width: 100%;
    padding: 0 1rem;
  }

  @media (max-width: 580px) {
    .search-item {
      display: none !important;
    }
    .logo {
      display: none;
    }
  }

  @media (max-width: 850px) {
    .logo {
      display: none;
    }
  }

  /** Style Algolia */
  :root {
    --docsearch-primary-color: var(--theme-accent);
    --docsearch-logo-color: var(--theme-text);
  }

  .search-item {
    position: relative;
    z-index: 10;
    flex-grow: 1;
    display: flex;
    max-width: 28%;
  }
</style>

<style is:global>
  .search-item > * {
    flex-grow: 1;
  }
</style>
