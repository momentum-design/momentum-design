---
import '../styles/theme.css';
import '../styles/index.css';
import '@momentum-design/fonts/dist/css/fonts.css';
import '@momentum-design/tokens/dist/css/typography/complete.css';
import '@momentum-design/tokens/dist/css/theme/webex/dark-stable.css';
import '@momentum-design/tokens/dist/css/theme/webex/light-stable.css';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<link rel="sitemap" href="/sitemap.xml" />

<!-- Preload Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital@0;1&display=swap" rel="stylesheet" />

<!-- Scrollable a11y code helper -->
<script src="/make-scrollable-code-focusable.js" is:inline></script>

<!-- This is intentionally inlined to avoid FOUC -->
<script is:inline>
  const root = document.documentElement;
  const theme = localStorage.getItem('theme');

  if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    root.classList.add('theme-dark');
    root.classList.add('mds-theme-stable-darkWebex');
    root.classList.remove('mds-theme-stable-lightWebex');
  } else {
    root.classList.remove('theme-dark');
    root.classList.add('mds-theme-stable-lightWebex');
    root.classList.remove('mds-theme-stable-darkWebex');
  }
</script>

<!-- Register the Momentum context providers and text component up-front so the
  whole page upgrades in a single paint. Hiding un-upgraded providers (below)
  avoids the flash-of-unstyled-text flicker on navigation. -->
<script>
  import '@momentum-design/components/dist/components/themeprovider/index.js';
  import '@momentum-design/components/dist/components/iconprovider/index.js';
  import '@momentum-design/components/dist/components/text/index.js';
  import '@momentum-design/components/dist/components/link/index.js';
</script>

<style is:global>
  /* AI-Assisted: Keep the outgoing page painted while the incoming page loads. */
  @view-transition {
    navigation: auto;
  }
  /* End AI-Assisted */

  /* Keep the provider wrappers layout-neutral in every state (their :host uses
     display: contents once upgraded; mirror that before upgrade too). */
  mdc-themeprovider,
  mdc-iconprovider {
    display: contents;
  }

  /* Hide the themed subtree until the providers upgrade so text never paints
     in a fallback font first. Theme colours already come from the <html> class. */
  mdc-themeprovider:not(:defined) {
    visibility: hidden;
  }
</style>

