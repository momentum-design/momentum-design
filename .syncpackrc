{
  "lintFormatting": false,
  "customTypes": {
    "nodeEngine": {
      "path": "engines.node",
      "strategy": "version"
    },
    "packageManager": {
      "path": "packageManager",
      "strategy": "version"
    },
    "yarnEngine": {
      "path": "engines.yarn",
      "strategy": "version"
    }
  },
  "dependencyTypes": [
    "prod",
    "dev",
    "nodeEngine",
    "packageManager",
    "yarnEngine"
  ],
  "semverGroups": [
    {
      "label": "api-extractor 7.60+ bundles TypeScript 6, which fails to resolve @types/node; stay on the 7.59 minor",
      "packages": [
        "**"
      ],
      "dependencyTypes": [
        "dev"
      ],
      "dependencies": [
        "@microsoft/api-extractor"
      ],
      "range": "~"
    },
    {
      "label": "use caret versions in production",
      "packages": [
        "**"
      ],
      "dependencyTypes": [
        "prod",
        "dev"
      ],
      "dependencies": [
        "**"
      ],
      "range": "^"
    }
  ],
  "versionGroups": [
    {
      "label": "Ensure all node engines are in the same range",
      "dependencyTypes": [
        "nodeEngine"
      ],
      "preferVersion": "24.18.0"
    },
    {
      "label": "Ensure all package manager are in the same range",
      "dependencyTypes": [
        "packageManager"
      ],
      "pinVersion": "yarn@4.18.1"
    },
    {
      "label": "Ensure all yarn engines are not set",
      "dependencyTypes": [
        "yarnEngine"
      ],
      "isBanned": true
    },
    {
      "label": "Ensure @types/node corresponds to the node engine",
      "dependencies": [
        "@types/node"
      ],
      "packages": [
        "**"
      ],
      "pinVersion": "20.14.9"
    },
    {
      "label": "Ensure all packages use same esbuild, typescript as the components package is using",
      "dependencies": [
        "esbuild",
        "typescript"
      ],
      "packages": [
        "**"
      ],
      "snapTo": [
        "@momentum-design/components"
      ]
    },
    {
      "label": "Ensure Eslint is on version 8.27.0 due to ESM support needed in latest version 9.9.0",
      "dependencies": [
        "eslint"
      ],
      "packages": [
        "**"
      ],
      "pinVersion": "8.27.0"
    },
    {
      "label": "Ensure Markdownlint is on version 0.36.1 due to ESM support needed in later versions",
      "dependencies": [
        "markdownlint"
      ],
      "packages": [
        "**"
      ],
      "pinVersion": "0.36.1"
    },
    {
      "label": "The docs site runs on Astro 7, which requires Vite 8; Storybook tooling stays on Vite 5",
      "dependencies": [
        "vite"
      ],
      "packages": [
        "@momentum-design/docs"
      ],
      "pinVersion": "^8.3.8"
    },
    {
      "label": "Dependencies should be the same version",
      "dependencies": [
        "**"
      ],
      "packages": [
        "**"
      ],
      "policy": "same"
    }
  ]
}
